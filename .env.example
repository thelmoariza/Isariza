# ---------- Sitio ----------
# URL pública (sin "/" final). Local: http://localhost:3000
SITE_URL=http://localhost:3000

# ---------- Wompi ----------
# Llaves en https://comercios.wompi.co  (Desarrolladores > Llaves). Usa las de SANDBOX para pruebas.
WOMPI_ENV=sandbox                      # sandbox | production
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxx

# ---------- Google Analytics 4 ----------
# Se embebe en build (variable pública). Ej: G-XXXXXXXXXX. Vacío = sin tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------- Persistencia de pedidos ----------
# file     -> guarda en ./data/orders.json (ideal para pruebas locales sin Docker)
# dynamodb -> AWS DynamoDB (o DynamoDB Local con docker compose)
ORDERS_STORE=file
DYNAMODB_TABLE=isariza-orders
AWS_REGION=us-east-1
# Solo para DynamoDB Local (docker compose lo define automáticamente)
DYNAMODB_ENDPOINT=

# ---------- Panel de pedidos (/admin) ----------
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
